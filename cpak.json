{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": "Acronis Connect Client",
  "description": "Manage remote connections, credentials, screens and file transfers.",
  "version": "1.1-25041",
  "image": "ghcr.io/containerpak/acronis-connect:main",
  "runtime_sources": [{"name": "acronisconnectclient-1.1-25041.x86_64.deb", "url": "https://dl.acronis.com/u/cyber-desktop-client/acronisconnectclient-1.1-25041.x86_64.deb", "sha256": "21b545e303194569d463bf70b2df802ddd86aeccb3f64732fc9b1cb4401dd565", "size": 137935400, "installer": "dpkg"}],
  "binaries": ["/usr/bin/acronisconnectclient", "/usr/bin/acc"],
  "desktop_entries": ["/usr/share/applications/acronisconnectclient.desktop"],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": false,
    "socketAtSpiBus": true,
    "socketBluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": true,
    "deviceVideo": true,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": true,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "filesystem": [{"path": "home", "access": "read-write"}],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false,
    "allowedHostCommands": ["xdg-open"]
  }
}
